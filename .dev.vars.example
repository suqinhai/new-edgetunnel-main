# Never commit the real relay secret. Generate a long random value and set the
# same value as CHATGPT_RELAY_SECRET in the price-radar server environment.
RADAR_RELAY_SECRET=replace-with-long-random-secret
RADAR_RELAY_MAX_BODY_BYTES=65536
RADAR_RELAY_TIMEOUT_MS=25000
RADAR_RELAY_RATE_LIMIT=30
RADAR_RELAY_ALLOWED_PAYMENT_HOSTS=checkout.stripe.com,buy.stripe.com
